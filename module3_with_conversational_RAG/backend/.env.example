# ── LLM provider switching ────────────────────────────────────────────────────
LLM_PROVIDER=groq                      # groq | openai | ollama

# ── Groq ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama3-70b-8192          # or mixtral-8x7b-32768

# ── OpenAI (optional — enable cloud OpenAI models) ────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Ollama (optional — enable local models) ───────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=handbook_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=handbook_chunks

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2    # lightweight 384-dim model
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info
